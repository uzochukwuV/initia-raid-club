# Phantasma Sportsbook - Environment Variables Template
# 
# Fill these from your Initia appchain launch output or published registry entry.
# 
# For Phantasma on Initia Move appchain:
# - Reference: https://github.com/Naabiae/Betbing3
# - Contract: quadratic_market::sportsbook (Move module)
# - Odds basis: 10,000 (e.g., 200 = 2.00x)

# Chain Identification
NEXT_PUBLIC_ROLLUP_CHAIN_ID=
NEXT_PUBLIC_ROLLUP_CHAIN_NAME=Phantasma
NEXT_PUBLIC_ROLLUP_PRETTY_NAME=Phantasma Sportsbook
NEXT_PUBLIC_ROLLUP_EVM_CHAIN_ID=

# RPC & API Endpoints
NEXT_PUBLIC_ROLLUP_RPC_URL=
NEXT_PUBLIC_ROLLUP_REST_URL=
NEXT_PUBLIC_ROLLUP_JSON_RPC_URL=
NEXT_PUBLIC_ROLLUP_INDEXER_URL=

# Native Token Configuration
NEXT_PUBLIC_ROLLUP_NATIVE_DENOM=
NEXT_PUBLIC_ROLLUP_NATIVE_SYMBOL=
NEXT_PUBLIC_ROLLUP_NATIVE_DECIMALS=18

# Deployed Phantasma Sportsbook Contract (Move module address)
# Format: 0x[hex address of quadratic_market::sportsbook]
NEXT_PUBLIC_PHANTASMA_CONTRACT=

# Bridge Configuration (Initia L1 Mainnet)
NEXT_PUBLIC_BRIDGE_SRC_CHAIN_ID=interwoven-1
NEXT_PUBLIC_BRIDGE_SRC_DENOM=uinit
NEXT_PUBLIC_ROLLUP_EXPLORER_URL=

# InterwovenKit Configuration
NEXT_PUBLIC_INTERWOVEN_APP_NAME=Phantasma
NEXT_PUBLIC_INTERWOVEN_PROJECT_ID=
